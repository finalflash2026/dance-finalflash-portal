# ============================================================
# 環境変数テンプレート (SPEC.md §2.1)
#
# これをコピーして .env.local を作り、値を埋めること:
#   cp .env.example .env.local
#
# .gitignore で .env* は除外されている。**値を入れたファイルは絶対にコミットしない**。
# 本番の値は Vercel の Environment Variables に設定する (SPEC §2.2)。
# ============================================================

# Supabase プロジェクトの URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# anon key。クライアントに露出してよい。RLS で守る
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key。**サーバー専用。クライアントに絶対露出させない**
# RLS を完全にバイパスするため、漏洩すると全データが読み書きされる
SUPABASE_SERVICE_ROLE_KEY=

# ics 内 UID のドメイン・購読URL生成に使用 (SPEC §10)
# ローカル: http://localhost:3000 / 本番: https://<デプロイURL>
APP_BASE_URL=http://localhost:3000

# Vercel Cron 認証用のランダム文字列 (SPEC §8.8 / §13.4)
# 生成例: openssl rand -base64 32
CRON_SECRET=
